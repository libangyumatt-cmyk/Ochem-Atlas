  a=m.eval_gto('GTOval_sph',grid[i:i+8000]);rho[i:i+len(a)]=np.einsum('pi,ij,pj->p',a,dm,a)
  if c is not None:phi[i:i+len(a)]=a@c
 return rho,phi

