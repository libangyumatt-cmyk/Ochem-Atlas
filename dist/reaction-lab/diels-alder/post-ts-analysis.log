def quadrature(m,dm):
 gr=dft.gen_grid.Grids(m);gr.level=5;gr.build();q=0.
 for i in range(0,len(gr.coords),10000):
  a=m.eval_gto('GTOval_sph',gr.coords[i:i+10000]);q+=np.einsum('pi,ij,pj->p',a,dm,a)@gr.weights[i:i+10000]
